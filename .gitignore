# Task 17 security audit fix: no .gitignore existed, so a developer
# creating a local `.env` (as `GoogleAuthService.build_connect_url`'s own
# error message and `app/core/config.py` suggest) had nothing preventing
# it from being committed alongside real GOOGLE_CLIENT_SECRET /
# TOKEN_ENCRYPTION_KEY / GEMINI_API_KEY / YOUTUBE_API_KEY values.

# Local environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
